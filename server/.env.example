# Copy to server/.env for local development. On Vercel, add the same names
# under Project Settings > Environment Variables (no quotes needed).

# --- Database ------------------------------------------------------------
# Local: mongodb://localhost:27017/portfolio
# Production: a MongoDB Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/portfolio

# --- Admin sign-in (JWT) --------------------------------------------------
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts (e.g. 12h, 7d).
JWT_TTL=12h

# First run only: on an empty database, signing in at /admin with these
# creates the admin account. Remove ADMIN_PASSWORD once you've signed in.
ADMIN_USERNAME=harshil
ADMIN_PASSWORD=

# --- Inquiry emails (Nodemailer) -------------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=harshill.barot@gmail.com
SMTP_PASS=
# Where new inquiries are delivered (defaults to the email in shared/site.json).
MAIL_TO=harshill.barot@gmail.com
MAIL_FROM_NAME=Harshil Barot

# Links in the emails (defaults to siteUrl in shared/site.json).
SITE_URL=https://harshil-barot.vercel.app

# Local server port (Vite proxies /api to it).
PORT=5000
